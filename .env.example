# Required. At least 32 random characters — the master key every stored credential is
# encrypted under. Generate one with:  openssl rand -base64 48
# Losing it makes saved connections unreadable; changing it means re-adding them.
JVINU_SECRET=

# Sign-in: an admin password (12+ characters), OIDC, or both. Leave the password empty to
# choose it in the browser at the first sign-in: the server's log prints a one-time setup
# code for that. When set here, it always takes over (also the way back in if you forget one).
JVINU_ADMIN_PASSWORD=

# OIDC (optional). Redirect URI to register: <JVINU_PUBLIC_URL>/api/auth/oidc/callback
# JVINU_OIDC_ISSUER=https://accounts.google.com
# JVINU_OIDC_CLIENT_ID=
# JVINU_OIDC_CLIENT_SECRET=
# Required with OIDC: comma-separated emails or @domains allowed in, e.g.
# alice@example.com,@example.com. Left empty, nobody can sign in with SSO — a public
# provider like Google would otherwise admit every Google account in the world.
# JVINU_OIDC_ALLOWED=
# Only if your provider has no accounts but your own (a private Keycloak, say): let every
# account it signs in through, with no allowlist.
# JVINU_OIDC_ALLOW_ANY=1
# An allowlisted email counts only if the provider marks it verified (email_verified). For a
# provider that never sends that claim (Microsoft Entra), trust its emails anyway:
# JVINU_OIDC_TRUST_UNVERIFIED_EMAIL=1

# Two-step sign-in is turned on in the app (account menu → Sign-in & security). If the phone
# and the recovery codes are both lost: set this, restart once, then remove it.
# JVINU_RESET_TWO_FACTOR=1

# Roles. Admins add and disconnect storage, change its settings and read-only, and manage
# the storage plan; members browse, preview, upload where allowed and share. The admin
# password is always an admin. SSO accounts listed here (emails or @domains) are admins;
# without this list they're admins only on a server with no admin password.
# JVINU_ADMINS=you@example.com,@ops.example.com

# The address people reach this server at: the OIDC redirect, and the address in share
# links (without it, a link uses whatever address jvinu was opened at).
# JVINU_PUBLIC_URL=https://storage.example.com

# Database: SQLite in JVINU_DATA_DIR by default; set a postgres:// URL to use Postgres.
# JVINU_DATABASE_URL=postgres://jvinu:secret@db:5432/jvinu
# JVINU_DATA_DIR=/data

# Largest single upload, in MB (default 5120).
# JVINU_MAX_UPLOAD_MB=5120
# Behind a reverse proxy, set to 1 so login throttling and share-link limits use X-Forwarded-For.
# Recommended: without it, a sender's address can be forged, so limits are shared (browsers
# that signed in before are still let in during a sign-in lockout).
# JVINU_TRUST_PROXY=1
# HTTPS with an automatic certificate (docker compose --profile proxy; see docs/https.md):
# JVINU_DOMAIN=files.example.com
# JVINU_BIND=127.0.0.1
# NODE_TLS_REJECT_UNAUTHORIZED=0 (no certificate checks) is ignored in production. Only if
# you really mean it:
# JVINU_ALLOW_INSECURE_TLS=1

# Disk space for image thumbnails, in MB, under JVINU_DATA_DIR/thumbs (default 1024).
# JVINU_THUMB_CACHE_MB=1024
# The most one zip download may hold, in GB (default 50). It may also hold at most 10,000 files.
# JVINU_ZIP_MAX_GB=50

# --- Data previews and lake tables (DuckDB, built in) -------------------------------
# The most one data preview may read, in MB (default 64). Parquet previews read the footer
# and first pages only; CSV and JSON the first 2 MB.
# JVINU_PREVIEW_MAX_MB=64
# The most a Delta checkpoint may be when totting up a table's files and rows (default 256).
# JVINU_LAKE_CHECKPOINT_MAX_MB=256
# DuckDB's memory cap (default 512MB); it spills to disk past that.
# JVINU_DUCKDB_MEMORY=512MB
# Scratch space for previews, cleaned up after each one (default: the system temp folder).
# JVINU_SCRATCH_DIR=/data/scratch

# --- SQL on files ------------------------------------------------------------------
# Most a query may fetch (MB), DuckDB's memory cap, time limit (s) and threads per query.
# JVINU_SQL_MAX_MB=1024
# JVINU_SQL_MEMORY=1GB
# JVINU_SQL_TIMEOUT_S=60
# JVINU_SQL_THREADS=2

# --- Public demo -------------------------------------------------------------------
# 1: anyone can "Explore the demo" without signing in; nothing can be changed. See docs/demo.md.
# JVINU_DEMO=1

# --- Bundled storage: docker compose --profile storage up -d -----------------------
# See docs/run-your-own-storage.md. Everything below is optional.
# Where the stored files live (a host path, e.g. a big disk); default: a Docker volume.
# JVINU_STORAGE_PATH=/mnt/bigdisk/jvinu-data
# Where Garage keeps its metadata (small; an SSD is best); default: a Docker volume.
# JVINU_STORAGE_META_PATH=/srv/jvinu-meta
# Publish the S3 API so other apps can use it too (port 3900 unless set):
# COMPOSE_PROFILES=storage,storage-s3
# JVINU_STORAGE_S3_PORT=3900
# JVINU_STORAGE_S3_BIND=0.0.0.0
# A public URL that reaches that S3 port (a tunnel or reverse proxy). Only then can
# "My storage" hand out direct links, and share links hand downloads off to it; otherwise
# its files are served through jvinu.
# JVINU_STORAGE_PUBLIC_URL=https://s3.example.com
# The bucket made on first run (default my-files).
# JVINU_STORAGE_BUCKET=my-files

# --- Cloud backup waitlist (optional) ------------------------------------------------
# When set, the account menu offers a "Cloud backup" waitlist form. Only what someone
# submits is forwarded (by this server, as JSON); nothing is sent otherwise.
# JVINU_WAITLIST_URL=https://example.com/waitlist
# Hide it even when a URL is set:
# JVINU_WAITLIST=off

# --- Buying storage (optional) -----------------------------------------------------
# A jvinu that sells storage: adds "Storage plan" to the account menu, and a managed
# "Cloud storage" connection once paid. See docs/sell-storage.md.
# JVINU_STORAGE_STORE_URL=https://store.example.com
# Hide it even when a URL is set:
# JVINU_STORAGE_STORE=off

# --- Selling storage (optional) ----------------------------------------------------
# Sell 100 GB blocks of B2 or Wasabi storage through Stripe. On only when the Stripe keys
# and one provider's keys are set. See docs/sell-storage.md.
# JVINU_SELLER_STRIPE_SECRET_KEY=sk_live_...
# JVINU_SELLER_STRIPE_WEBHOOK_SECRET=whsec_...
# A recurring monthly, tax-inclusive Price (recommended; lets customers change size):
# JVINU_SELLER_STRIPE_PRICE=price_...
# 1: let Stripe Tax work out each country's VAT inside the price.
# JVINU_SELLER_STRIPE_TAX=1
# Price per 100 GB a month, VAT included, in euro cents (default 300 = €3.00).
# JVINU_SELLER_PRICE_CENTS=300
# JVINU_SELLER_PROVIDER=b2
# JVINU_SELLER_B2_KEY_ID=
# JVINU_SELLER_B2_KEY=
# JVINU_SELLER_WASABI_ACCESS_KEY=
# JVINU_SELLER_WASABI_SECRET_KEY=
# JVINU_SELLER_WASABI_REGION=eu-central-2
# Days a cancelled plan stays readable before its bucket is deleted (default 30).
# JVINU_SELLER_KEEP_DAYS=30
# Your terms of service (https): buyers must accept them at checkout. Set the same URL in
# Stripe → Settings → Public details.
# JVINU_SELLER_TERMS_URL=https://example.com/storage-terms
# 32+ random characters: turns on /api/store/admin, for finding and suspending abusive orders.
# JVINU_SELLER_ADMIN_TOKEN=

# --- Email (optional): storage customers' notices and the seller's alerts -------------
# Your SMTP server: smtps://…:465, or smtp://…:587 (always upgraded to TLS).
# JVINU_SMTP_URL=smtps://user:password@smtp.example.com:465
# JVINU_MAIL_FROM="Cloud storage <storage@example.com>"
# The name in the emails' subjects (default "Cloud storage").
# JVINU_SELLER_NAME=Cloud storage
# Where the seller is told when something unattended fails (webhook, hourly check,
# provisioning, checkout): an email address and/or an https Slack/Discord webhook.
# JVINU_SELLER_ALERT_EMAIL=you@example.com
# JVINU_SELLER_ALERT_WEBHOOK=https://hooks.slack.com/services/…

# --- Selling: price floor and yearly billing (optional) -------------------------------
# Smallest plan, in 100 GB blocks (default 1). Card fees are per invoice: 2 makes them half as heavy.
# JVINU_SELLER_MIN_BLOCKS=2
# Offer yearly billing at this price per block, VAT included, in euro cents (e.g. 3000 = €30, two months free).
# JVINU_SELLER_YEARLY_PRICE_CENTS=3000
# A recurring yearly, tax-inclusive Stripe Price for it (recommended, like JVINU_SELLER_STRIPE_PRICE).
# JVINU_SELLER_STRIPE_PRICE_YEARLY=price_...

# --- Backups (scripts/backup.mjs; see docs/backups.md) --------------------------------
# Not read by jvinu itself: pass it to the backup and restore scripts.
# JVINU_BACKUP_PASSPHRASE=
